# backend/.dockerignore

# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtualenvs
env/
venv/

# Git
.git/

# Local secrets / dotenv
.env
.env.*

# Logs
*.log

# Monorepo frontend
frontend/

# Host-side Hugging Face cache (if ever pre-downloaded locally)
model_cache/
**/.cache/

# IDE settings
.vscode/
.idea/